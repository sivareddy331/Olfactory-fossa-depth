{
  "name": "olfactory-appium-automation",
  "version": "1.0.0",
  "description": "Enterprise Appium 2.x Mobile Automation Framework for Olfactory Android Application",
  "scripts": {
    "test": "mocha 'tests/**/*.test.js' --timeout 120000 --reporter spec",
    "test:report": "mocha 'tests/**/*.test.js' --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/html,reportFilename=appium-execution-report",
    "report": "node utils/report-generator.js"
  },
  "dependencies": {
    "webdriverio": "^8.36.1",
    "mocha": "^10.3.0",
    "chai": "^4.4.1",
    "mochawesome": "^7.1.3",
    "exceljs": "^4.4.0",
    "winston": "^3.12.0",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "@wdio/appium-service": "^8.36.1"
  }
}
